# ===== Banco de Dados (PostgreSQL) =====
# Ajuste usuario, senha, host, porta e nome do banco conforme seu ambiente.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airia

# ===== Segurança / JWT =====
# Gere um segredo forte, ex.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== Serviços externos (usados nas próximas etapas) =====
# Chave da API do Google Gemini (Etapa 3) - pegue em https://aistudio.google.com
GEMINI_API_KEY=
# Chave da OpenAQ (Etapa 2) - se a versão da API exigir
OPENAQ_API_KEY=

# ===== Aplicação =====
APP_NAME=AirIA
DEBUG=true
